<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.kristina.telephony.server.mapper.RoomMapper">
	<resultMap id="RoomResultMap"
		type="com.kristina.telephony.shared.Room">
		<id property="id" column="id" />
		<result property="name" column="name" />
	</resultMap>

	<select id=findAll resultMap="RoomResultMap">
		SELECT id, name
		FROM room
		ORDER BY
		name;
	</select>

	<select id=findById resultMap="RoomResultMap"
		parameterType="java.lang.Long">
		SELECT id, name
		FROM room
		WHERE id=#{id};
	</select>

</mapper>
